{
  "name": "@local/dsh-prefill",
  "version": "0.15.2",
  "private": true,
  "type": "module",
  "description": "DSH Web 会话预填装 + 注入闸门（Prefill Pack + Gate）",
  "icon": "./icon.svg",
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "blocks.js",
    "impl.js",
    "builtin-presets.js",
    "character-cards.js",
    "session-history.js",
    "constraint-carry.js",
    "inject-auto.js",
    "enabled.js",
    "workspace-instructions.js",
    "gate.js",
    "injection-audit.js",
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.1.7-rc.2": "compatible",
        "0.2.0-rc.2": "compatible",
        "0.2.1-rc.3": "compatible"
      }
    }
  }
}
